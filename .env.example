# Copia este archivo como .env.local para desarrollo.
# En Netlify, estas mismas cuatro van en Site configuration → Environment variables.

# ── La dirección a la que apunta el QR ───────────────────────────────────────
# VACÍA en desarrollo y en la reunión: así el QR toma la dirección por la que
# estés abriendo el tablero. Si abres http://192.168.2.152:3000 desde la laptop,
# el QR sale con esa IP y el celular del prospecto llega. Con "localhost" el QR
# diría localhost y ningún celular ajeno podría abrirlo.
#
# En Netlify se pone el dominio real, con https y sin barra final:
#   NEXT_PUBLIC_BASE_URL=https://allez-taller.netlify.app
NEXT_PUBLIC_BASE_URL=

# ── Teléfono del botón "Llamar al taller" de la página del cliente ───────────
# A propósito es el de Mito: si el socio o el contador del prospecto lo pulsa,
# suena su teléfono. Eso es una oportunidad de venta, no un botón decorativo.
NEXT_PUBLIC_TELEFONO_TALLER=+593979279337

# ── Turso ────────────────────────────────────────────────────────────────────
# Vacías = archivo local ./data/allez.db (desarrollo).
# En Netlify son obligatorias: las funciones no tienen disco donde escribir.
#   turso db create allez-taller
#   turso db show allez-taller --url
#   turso db tokens create allez-taller
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
